MCP_HOST=0.0.0.0
MCP_PORT=8001
CAMERA_SEND_COUNT=3
LMSTUDIO_URL=http://localhost:1234/v1/
VISION_MODEL=qwen/qwen3.5-9b

# --- Obsidian vault tools (optional) -----------------------------------------
# Set VAULT_ROOT to an Obsidian vault on THIS machine to expose the vault_* tools.
# Leave it unset and they are not registered at all -- an instance without a
# vault does not advertise vault tools it cannot serve.
# VAULT_ROOT=C:\Users\you\Documents\YourVault
# VAULT_AGENT_NS: the only folder the agent may write to. Default "Eva".
# VAULT_AGENT_OWNER: value stamped into each note's `owner:` frontmatter.
#   Defaults to the lowercased namespace.
# VAULT_AGENT_NS=Eva
# VAULT_AGENT_OWNER=eva
